<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="setup_title">Настройка</string>
    <string name="setup_question">Что вам нужно?</string>
    <string name="setup_intro">Выберите, с чего начать. Каждому приложению можно назначить прямой маршрут, VPN или DPI.</string>
    <string name="setup_goal_dpi">Только YouTube / DPI</string>
    <string name="setup_goal_dpi_hint">Обход замедления без VPN-сервера. Результат зависит от сети.</string>
    <string name="setup_goal_vless">У меня VLESS</string>
    <string name="setup_goal_vless_hint">Вставьте ключ vless:// от своего VPN-провайдера.</string>
    <string name="setup_goal_subscription">У меня подписка</string>
    <string name="setup_goal_subscription_hint">Добавьте HTTPS-ссылку на подписку своего провайдера.</string>
    <string name="setup_goal_warp">WARP / Amnezia</string>
    <string name="setup_goal_warp_hint">Импортируйте файл конфигурации или вставьте ключ Amnezia.</string>
    <string name="setup_skip">Настрою позже</string>
    <string name="setup_profile">Выбрать VPN-профиль</string>
    <string name="setup_profile_hint">Добавьте или импортируйте профиль, затем выберите его.</string>
    <string name="setup_profile_ready">Профиль выбран</string>
    <string name="setup_apps">Выбрать приложения</string>
    <string name="setup_apps_dpi">Назначьте DPI приложениям, которым он нужен.</string>
    <string name="setup_apps_vpn">Назначьте VPN приложениям, которым он нужен.</string>
    <string name="setup_apps_ready">Приложений на этом маршруте: %1$d</string>
    <string name="setup_permission_hint">Нажмите «Подключить», когда всё готово. Android попросит разрешение на VPN. Другой VPN одновременно работать не сможет.</string>
    <string name="setup_existing_vpn">Некоторым приложениям уже назначен VPN. Выберите VPN-профиль или верните им прямой маршрут.</string>
    <string name="setup_dpi_test">Подобрать стратегию DPI</string>
    <string name="setup_connected">Подключено. Всё готово к работе.</string>
    <string name="setup_done">На главный экран</string>
    <string name="setup_cancel_connect">Отменить подключение</string>
    <string name="setup_saving">Сохранение…</string>
    <string name="setup_save_error">Не удалось завершить настройку. Повторите попытку.</string>
    <string name="setup_continue">Продолжить</string>
    <string name="setup_profiles_hint">Выберите профиль и нажмите «Продолжить».</string>
    <string name="setup_menu_hint">Помощь с первым подключением</string>
</resources>
